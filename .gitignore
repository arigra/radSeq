__pycache__/
*.pyc
data/
checkpoints/
# samples/* rather than samples/ so git descends and the negations below apply
samples/*
# ...keeping the small diagnostic reports the notebook and notes cite
!samples/*.json
!samples/*.yaml
wandb/
.superpowers/
logs/
*.log
# per-batch-size configs generated by the run_*.sh pipelines
configs/*_bs[0-9]*.yaml
experiments/*/configs/*_bs[0-9]*.yaml
# experiment and archive results: keep the small json/yaml reports, not the
# figures, tensors and sample dumps
experiments/*/results/*
!experiments/*/results/*.json
!experiments/*/results/*.yaml
archive/*/results/*
!archive/*/results/*.json
!archive/*/results/*.yaml
archive/*/pilot_emabug/
archive/notebook_tools/scratch/

# data/ holds bulk caches, but the pinned RADIal split and the fitted receiver
# response are small research artifacts that results depend on: version them.
!data/radial/
!data/radial/split.json
